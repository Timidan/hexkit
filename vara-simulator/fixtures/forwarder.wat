;; Program 1 calls counter at actor 2 after two blocks, waits, and forwards its reply.
;; One outstanding call at a time is enough for this async regression fixture.
(module
  (import "env" "memory" (memory 1))
  (import "env" "gr_message_id" (func $id (param i32)))
  (import "env" "gr_read" (func $read (param i32 i32 i32 i32)))
  (import "env" "gr_send_wgas" (func $send (param i32 i32 i32 i64 i32 i32)))
  (import "env" "gr_wait" (func $wait))
  (import "env" "gr_wake" (func $wake (param i32 i32 i32)))
  (import "env" "gr_reply" (func $reply (param i32 i32 i32 i32)))
  (import "env" "gr_reply_code" (func $code (param i32)))
  (data (i32.const 0) "\02")
  (func (export "init"))
  (func (export "handle")
    (if (i32.eqz (i32.load (i32.const 300)))
      (then
        (call $id (i32.const 320))
        (call $read (i32.const 0) (i32.const 1) (i32.const 64) (i32.const 96))
        (call $send (i32.const 0) (i32.const 64) (i32.const 1) (i64.const 60000000000) (i32.const 2) (i32.const 96))
        (if (i32.load (i32.const 96)) (then unreachable))
        (i32.store (i32.const 300) (i32.const 1))
        (call $wait)
      )
    )
    (i32.store (i32.const 300) (i32.const 0))
    (if (i32.load (i32.const 304)) (then unreachable))
    (call $reply (i32.const 384) (i32.const 4) (i32.const -1) (i32.const 96))
  )
  (func (export "handle_reply")
    (call $code (i32.const 96))
    (i32.store (i32.const 304) (i32.load8_u (i32.const 100)))
    (call $read (i32.const 0) (i32.const 4) (i32.const 384) (i32.const 96))
    (if (i32.load (i32.const 96)) (then unreachable))
    (call $wake (i32.const 320) (i32.const 0) (i32.const 96))
  )
)
